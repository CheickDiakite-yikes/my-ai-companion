# Copy to .env.local for local Google OAuth + live voice testing.
# Use 127.0.0.1 on machines where localhost:5000 is occupied by another service.

HOST=127.0.0.1
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
SESSION_SECRET=replace-with-a-long-local-session-secret
# Leave GEMINI_API_KEY unset here to inherit from .env, or set a local override explicitly.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/integrations/google/callback
GOOGLE_OAUTH_AUTH_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback
GOOGLE_OAUTH_STATE_SIGNING_SECRET=replace-with-a-long-local-google-state-secret
GOOGLE_INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-local-google-encryption-key
GOOGLE_AUTH_POST_LOGIN_REDIRECT=/
ENABLE_GOOGLE_OAUTH_DYNAMIC_CALLBACK_HOST=true
ENABLE_GOOGLE_OAUTH_REDIRECT_URI_OVERRIDE=true

ENABLE_GOOGLE_PERSONAL_CONTEXT=true
ENABLE_GOOGLE_PERSONAL_CONTEXT_TEXT=true
ENABLE_GOOGLE_PERSONAL_CONTEXT_VOICE=true
ENABLE_GOOGLE_PERSONAL_CONTEXT_DETAIL_READS=true
ENABLE_GOOGLE_PERSONAL_CONTEXT_WRITES=true
ENABLE_VOICE_GOOGLE_WRITE_HANDOFF=true
VITE_ENABLE_GOOGLE_PERSONAL_CONTEXT_VOICE=true
VITE_ENABLE_GOOGLE_PERSONAL_CONTEXT_WRITES=true

GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar.events.readonly,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/calendar.events
