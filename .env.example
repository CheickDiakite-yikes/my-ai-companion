DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
SESSION_SECRET=replace-with-a-long-random-secret

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Text generation tuning
GEMINI_TEXT_TEMPERATURE=0.85
GEMINI_TEXT_TOP_P=0.95
GEMINI_TEXT_MAX_OUTPUT_TOKENS=1024
GEMINI_TEXT_MEMORY_WINDOW_MESSAGES=40

# Live token + VAD tuning
GEMINI_LIVE_TOKEN_USES=1
GEMINI_LIVE_TOKEN_EXPIRE_MS=1800000
GEMINI_LIVE_NEW_SESSION_EXPIRE_MS=60000
GEMINI_LIVE_LOW_LATENCY_MODE=true
GEMINI_LIVE_ACTIVITY_HANDLING=NO_INTERRUPTION
GEMINI_LIVE_VAD_START_SENSITIVITY=LOW
GEMINI_LIVE_VAD_END_SENSITIVITY=HIGH
GEMINI_LIVE_VAD_PREFIX_PADDING_MS=60
GEMINI_LIVE_VAD_SILENCE_MS=220
GEMINI_LIVE_MIN_VAD_PREFIX_PADDING_MS=50
GEMINI_LIVE_MIN_VAD_SILENCE_MS=180
GEMINI_LIVE_TURN_COVERAGE=TURN_INCLUDES_ONLY_ACTIVITY
GEMINI_LIVE_ENABLE_AFFECTIVE_DIALOG=true
GEMINI_LIVE_PROACTIVE_AUDIO=false
GEMINI_LIVE_FORCE_ALWAYS_RESPOND=true
GEMINI_LIVE_USE_THINKING_CONFIG=true
GEMINI_LIVE_ALLOW_ZERO_THINKING_BUDGET=false
GEMINI_LIVE_THINKING_BUDGET=64
GEMINI_LIVE_INCLUDE_THOUGHTS=false
GEMINI_LIVE_TEMPERATURE=0.45
GEMINI_LIVE_TOP_P=0.85
GEMINI_LIVE_TOP_K=24
GEMINI_LIVE_MAX_OUTPUT_TOKENS=1000
ENABLE_LIVE_MEMORY_CONTEXT=true
LIVE_MEMORY_BUILD_TIMEOUT_MS=1800
LIVE_MEMORY_ACTIVE_THREAD_MAX_MESSAGES=60
LIVE_MEMORY_CROSS_CHAT_MAX_MESSAGES=80
LIVE_MEMORY_POLICY_DEFAULT=safe_selective

# Client live audio capture tuning (Vite env)
VITE_LIVE_AUDIO_PROCESSOR_BUFFER_SIZE=512
VITE_LIVE_AUDIO_NOISE_GATE_ENABLED=false
VITE_LIVE_AUDIO_NOISE_GATE_RMS_THRESHOLD=0.006
VITE_LIVE_AUDIO_NOISE_GATE_HANGOVER_FRAMES=3
VITE_LIVE_AUDIO_NOISE_GATE_FAILOPEN_ENABLED=false
VITE_LIVE_AUDIO_NOISE_GATE_ASSISTANT_SPEECH_MULTIPLIER=1.45
VITE_LIVE_AUDIO_NOISE_GATE_FAILOPEN_AFTER_DROPS=120
VITE_LIVE_AUDIO_NOISE_GATE_FAILOPEN_FRAMES=60
VITE_LIVE_AUDIO_SUPPRESS_INPUT_WHILE_ASSISTANT_SPEAKING=true
VITE_LIVE_AUDIO_SUPPRESS_INPUT_COOLDOWN_MS=240
VITE_LIVE_AUDIO_SUPPRESS_USER_TRANSCRIPT_DURING_ASSISTANT_SPEECH=true

# Media storage + security
MEDIA_STORAGE_DRIVER=auto
MEDIA_REPLIT_BUCKET_ID=replit-objstore-b4d43eea-9e5f-4865-9488-56bf8827895e
MEDIA_LOCAL_DIR=/tmp/my-ai-companion-media
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret

# Chat image limits
CHAT_IMAGE_MAX_COUNT=3
CHAT_IMAGE_MAX_BYTES=8388608

# Feature flags
ENABLE_MULTIPART_TEXT=true
ENABLE_AGENT_MODEL_PLANNER=false
ENABLE_AGENT_MODEL_GAME_GENERATOR=true
AGENT_GAME_MODEL=gemini-3-flash-preview
AGENT_GAME_MAX_RETRIES=2
AGENT_GAME_MAX_FILES=12
AGENT_GAME_MAX_TOTAL_BYTES=350000
AGENT_GAME_ENABLE_LIGHT_3D=true
ENABLE_AGENT_MODEL_DOC_GENERATOR=true
AGENT_DOC_MODEL=gemini-3-flash-preview
AGENT_DOC_MAX_RETRIES=2
ENABLE_AGENT_PROACTIVE_OFFERS=true
ENABLE_AGENT_OFFERS_V2=true
ENABLE_AGENT_INTENT_SESSIONS=true
ENABLE_AGENT_MODEL_INTENT_CLASSIFIER=true
AGENT_MODEL_INTENT_CLASSIFIER_MIN_CONFIDENCE=0.65
ENABLE_CONTEXT_MESSAGE_PURPOSE_FILTER=true
ENABLE_AGENT_UI_PURPOSE_BACKFILL_ON_BOOT=false
ENABLE_DOC_STRICT_PUBLISH=true
ENABLE_PRESENTATION_IMAGE_STRICT=true
ENABLE_AGENT_PRESENTATION_IMAGE_GENERATION=true
AGENT_PRESENTATION_MAX_SLIDES=5
AGENT_PRESENTATION_IMAGE_MODEL=gemini-3-pro-image-preview
ENABLE_AGENT_CODE_WORKER=true
AGENT_CODE_WORKER_BACKEND=gemini_api
AGENT_GEMINI_CLI_COMMAND=gemini
AGENT_GEMINI_CLI_TIMEOUT_MS=75000
ENABLE_UNIFIED_AGENT_TASK_CARD=true
VITE_ENABLE_UNIFIED_AGENT_TASK_CARD=true
ENABLE_JSON_RENDER_ARTIFACT_VIEWER="true"
VITE_ENABLE_JSON_RENDER_ARTIFACT_VIEWER="true"
ENABLE_PROFILE_PERSONALIZATION=true
ENABLE_BETA_QUOTAS=true

# Beta rolling-30-day quota limits
BETA_TEXT_QUOTA_30D=200
BETA_VOICE_QUOTA_SECONDS_30D=600
BETA_CAMERA_QUOTA_SECONDS_30D=600

# Privileged tester quota overrides (by email, comma-separated)
BETA_PRIVILEGED_QUOTA_EMAILS=zorovt18@gmail.com
BETA_PRIVILEGED_TEXT_QUOTA_30D=5000
BETA_PRIVILEGED_VOICE_QUOTA_SECONDS_30D=21600
BETA_PRIVILEGED_CAMERA_QUOTA_SECONDS_30D=21600
BETA_PRIVILEGED_QUOTA_CACHE_TTL_MS=300000
