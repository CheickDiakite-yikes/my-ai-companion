DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
SESSION_SECRET=replace-with-a-long-random-secret

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Text generation tuning
GEMINI_TEXT_TEMPERATURE=0.85
GEMINI_TEXT_TOP_P=0.95
GEMINI_TEXT_MAX_OUTPUT_TOKENS=1024
GEMINI_TEXT_MEMORY_WINDOW_MESSAGES=40

# Live token + VAD tuning
GEMINI_LIVE_TOKEN_USES=1
GEMINI_LIVE_TOKEN_EXPIRE_MS=1800000
GEMINI_LIVE_NEW_SESSION_EXPIRE_MS=60000
GEMINI_LIVE_VAD_START_SENSITIVITY=HIGH
GEMINI_LIVE_VAD_END_SENSITIVITY=HIGH
GEMINI_LIVE_VAD_PREFIX_PADDING_MS=80
GEMINI_LIVE_VAD_SILENCE_MS=380

# Media storage + security
MEDIA_STORAGE_DRIVER=auto
MEDIA_REPLIT_BUCKET_ID=replit-objstore-b4d43eea-9e5f-4865-9488-56bf8827895e
MEDIA_LOCAL_DIR=/tmp/my-ai-companion-media
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret

# Chat image limits
CHAT_IMAGE_MAX_COUNT=3
CHAT_IMAGE_MAX_BYTES=8388608

# Feature flags
ENABLE_MULTIPART_TEXT=true
ENABLE_PROFILE_PERSONALIZATION=true
ENABLE_BETA_QUOTAS=true

# Beta rolling-30-day quota limits
BETA_TEXT_QUOTA_30D=200
BETA_VOICE_QUOTA_SECONDS_30D=600
BETA_CAMERA_QUOTA_SECONDS_30D=600
