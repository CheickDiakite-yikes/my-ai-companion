{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "mobile:install": "npm --prefix mobile install",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:web": "npm --prefix mobile run web",
    "remotion:studio": "remotion studio video/index.ts",
    "remotion:render": "remotion render video/index.ts PromoOrbit45 output/remotion/zeeme-orbit-of-you.mp4 --codec=h264",
    "remotion:render:preview": "remotion render video/index.ts PromoOrbit45 output/remotion/zeeme-orbit-of-you-preview.mp4 --codec=h264 --scale=0.5",
    "dev:context": "bash script/dev-context.sh",
    "dev:handoff": "bash script/dev-handoff.sh",
    "security:secrets": "bash script/check-secrets.sh all",
    "security:secrets:staged": "bash script/check-secrets.sh staged",
    "test:local:e2e": "bash script/local-isolated-e2e.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "test:agent:smoke": "tsx script/agent-runtime-smoke.ts",
    "test:agent:flow": "tsx script/agent-runtime-flow-smoke.ts",
    "test:agent:sandbox": "tsx script/agent-sandbox-policy-smoke.ts",
    "test:agent:theme": "tsx script/agent-theme-contract-smoke.ts",
    "test:agent": "npm run test:agent:smoke && npm run test:agent:flow && npm run test:agent:sandbox && npm run test:agent:theme",
    "test:agent:contract": "bash script/agent-stream-contract-e2e.sh",
    "test:agent:ui": "bash script/agent-ui-theme-playwright-e2e.sh",
    "test:google-context:smoke": "tsx script/google-personal-context-smoke.ts",
    "test:google-context:ui": "bash script/google-personal-context-playwright-e2e.sh",
    "backfill:message-purpose": "tsx script/backfill-agent-ui-message-purpose.ts",
    "db:push": "drizzle-kit push"
  },
