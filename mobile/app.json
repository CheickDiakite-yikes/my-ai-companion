{
  "expo": {
    "name": "ZeeMe",
    "slug": "zeeme-mobile",
    "scheme": "zeeme",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f1a"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
